{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "rebuild-shared",
      "type": "process",
      "command": "dotnet",
      "args": [
        "build",
        "${workspaceFolder}/TiaOpenness_Tool_Consts/TiaOpenness_Tool_Shared.csproj",
        "-c",
        "Debug",
        "--no-incremental"
      ],
      "problemMatcher": "$msCompile",
      "group": "build"
    },
    {
      "label": "rebuild-rest-compile",
      "type": "process",
      "command": "dotnet",
      "args": [
        "msbuild",
        "${workspaceFolder}/TiaOpenness_Tool_TiaREST/TiaOpenness_Tool_TiaREST.csproj",
        "/p:Configuration=Debug",
        "/t:Rebuild",
        "/v:m"
      ],
      "dependsOn": ["rebuild-shared"],
      "dependsOrder": "sequence",
      "problemMatcher": "$msCompile",
      "group": "build",
      "detail": "Baut TiaREST neu (ohne UAC-Whitelist)"
    },
    {
      "label": "update-openness-whitelist",
      "type": "shell",
      "command": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File \"${workspaceFolder}/scripts/Update-TiaOpennessWhitelist.ps1\" -ExePath \"${workspaceFolder}/TiaOpenness_Tool_TiaREST/bin/Debug/TiaOpenness_Tool_TiaREST.exe\" -TiaVersion \"20.0\"",
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      },
      "detail": "Aktualisiert den TIA Openness Whitelist-Eintrag (UAC falls noetig)"
    },
    {
      "label": "rebuild-rest",
      "dependsOrder": "sequence",
      "dependsOn": ["rebuild-rest-compile", "update-openness-whitelist"],
      "problemMatcher": [],
      "group": "build",
      "detail": "Baut TiaREST neu und aktualisiert die Openness-Whitelist"
    },
    {
      "label": "rebuild-mcp",
      "type": "process",
      "command": "dotnet",
      "args": [
        "build",
        "${workspaceFolder}/TiaOpenness_Tool_TiaMCP/TiaOpenness_Tool_TiaMCP.csproj",
        "-c",
        "Debug",
        "--no-incremental"
      ],
      "dependsOn": ["rebuild-shared"],
      "dependsOrder": "sequence",
      "problemMatcher": "$msCompile",
      "group": "build"
    },
    {
      "label": "rebuild-all",
      "dependsOrder": "sequence",
      "dependsOn": ["rebuild-rest", "rebuild-mcp"],
      "problemMatcher": [],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "detail": "Baut Shared, TiaREST und TiaMCP neu (Debug) inkl. Openness-Whitelist"
    }
  ]
}
