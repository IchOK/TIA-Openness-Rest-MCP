{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "TiaOpenness": {
      "type": "remote",
      "url": "http://localhost:6281/mcp",
      "enabled": true,
      "oauth": false,
      "timeout": 60000,
      "headers": {
        "X-API-Key": "TiaOpennessDefaultToken"
      }
    }
  },
  "permission": {
    "skill": {
      "tia-plc-workspace": "allow"
    }
  }
}
